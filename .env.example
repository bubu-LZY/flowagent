# ====== FlowAgent 本地配置示例（复制为 .env.local 后填值，绝不提交真实值） ======

# 默认全局模型（OpenAI 兼容协议）
DEFAULT_API_BASE=https://api.openai.com/v1
DEFAULT_API_KEY=sk-YOUR-OPENAI-KEY-HERE
DEFAULT_MODEL=gpt-4o

# 可选：各智能体单独配置（不填就回退到默认）
# 项目经理（强制看图模型，多模态）
# PROJECT_MANAGER_API_BASE=https://api.openai.com/v1
# PROJECT_MANAGER_API_KEY=sk-YOUR-KEY
# PROJECT_MANAGER_MODEL=gpt-4o

# 评审员（强制 vision）
# REVIEWER_API_BASE=https://api.openai.com/v1
# REVIEWER_API_KEY=sk-YOUR-KEY
# REVIEWER_MODEL=gpt-4o

# 经验沉淀路径（Electron 环境生效；用相对路径或 ~ 开头的路径，避免硬编码用户目录）
# FLOWAGENT_STORAGE_PATH=<自定义存储路径，例如 ~/Documents/FlowAgent>
